{
    "$schema": "https://www.schemastore.org/tsconfig.json",
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "tsBuildInfoFile": "./.cache/tsbuildinfo/tsconfig.js.tsbuildinfo"
    },
    "extends": "./tsconfig.json",
    "include": [
        "*.cjs",
        "*.js",
        "*.mjs",
        ".*.cjs",
        ".*.js",
        ".*.mjs",
        "docs/**/*.js",
        "scripts/**/*.mjs"
    ]
}
